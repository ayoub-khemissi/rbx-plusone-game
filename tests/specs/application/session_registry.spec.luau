--!nocheck
local SessionRegistry = require(Application.SessionRegistry)
local Profile = require(Domain.Profile.Profile)

describe("SessionRegistry", function()
	local registry
	beforeEach(function()
		registry = SessionRegistry.new()
	end)

	it("ouvre une session avec un etat initial neutre", function()
		local session = registry:open(7, Profile.create())
		expect(session.userId).toBe(7)
		expect(session.zoneId).toBe(1)
		expect(session.savable).toBe(true)
		expect(session.lastPosition).toBeNil()
		expect(session.passes).toEqual({})
	end)

	it("retrouve et compte les sessions ouvertes", function()
		registry:open(1, Profile.create())
		registry:open(2, Profile.create())
		expect(registry:count()).toBe(2)
		expect(registry:get(2).userId).toBe(2)
		expect(registry:get(99)).toBeNil()
	end)

	it("ferme une session et la retire du registre", function()
		registry:open(3, Profile.create())
		local closed = registry:close(3)
		expect(closed.userId).toBe(3)
		expect(registry:get(3)).toBeNil()
		expect(registry:count()).toBe(0)
		expect(registry:close(3)).toBeNil()
	end)

	it("parcourt toutes les sessions", function()
		registry:open(1, Profile.create())
		registry:open(2, Profile.create())
		local seen = {}
		registry:forEach(function(session)
			table.insert(seen, session.userId)
		end)
		table.sort(seen)
		expect(seen).toEqual({ 1, 2 })
	end)

	it("resout une session a partir d'un objet joueur", function()
		local player = Fakes.player(42)
		registry:open(42, Profile.create())
		expect(registry:forPlayer(player).userId).toBe(42)
	end)
end)
