--!nocheck
local Result = require(Domain.Support.Result)
local Format = require(Domain.Support.Format)

describe("Result", function()
	it("carries a value on success", function()
		local result = Result.ok({ cost = 10 })
		expect(result.ok).toBe(true)
		expect(result.value.cost).toBe(10)
		expect(result.code).toBeNil()
	end)

	it("carries a code and a message on failure", function()
		local result = Result.err("INSUFFICIENT_FUNDS", "Not enough gold")
		expect(result.ok).toBe(false)
		expect(result.code).toBe("INSUFFICIENT_FUNDS")
		expect(result.message).toBe("Not enough gold")
	end)

	it("unwraps a success and throws on a failure", function()
		expect(Result.unwrap(Result.ok(42))).toBe(42)
		expect(function()
			Result.unwrap(Result.err("BOOM", "broken"))
		end).toThrow("BOOM")
	end)
end)

describe("Format", function()
	it("leaves small numbers readable", function()
		expect(Format.abbreviate(0)).toBe("0")
		expect(Format.abbreviate(12)).toBe("12")
		expect(Format.abbreviate(999)).toBe("999")
	end)

	it("abbreviates large numbers", function()
		expect(Format.abbreviate(1000)).toBe("1K")
		expect(Format.abbreviate(1500)).toBe("1.5K")
		expect(Format.abbreviate(1250000)).toBe("1.25M")
		expect(Format.abbreviate(3.4e9)).toBe("3.4B")
	end)

	it("handles negative numbers", function()
		expect(Format.abbreviate(-2500)).toBe("-2.5K")
	end)

	it("formats percentages and multipliers", function()
		expect(Format.percent(0.25)).toBe("25%")
		expect(Format.multiplier(2)).toBe("x2")
		expect(Format.multiplier(1.35)).toBe("x1.35")
	end)

	it("formats durations", function()
		expect(Format.duration(92)).toBe("1m 32s")
		expect(Format.duration(3700)).toBe("1h 1m")
	end)
end)
